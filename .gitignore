# ============================================
# Android
# ============================================
*.iml
.gradle/
/local.properties
/.idea/
/build/
/app/build/
/captures
.externalNativeBuild/
.cxx/

# APK/AAB files (use GitHub Releases instead)
*.apk
*.aab
*.ap_

# Signing keys (NEVER commit)
*.jks
*.keystore
keystore.properties

# Android profiling
*.hprof

# ============================================
# Backend (Node.js)
# ============================================
node_modules/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (contain secrets)
.env
.env.local
.env.*.local
backend/.env

# ============================================
# IDE & Editors
# ============================================
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Copilot / AI Tools
# ============================================
.copilot/

# ============================================
# Testing
# ============================================
/coverage/
*.lcov
.nyc_output/

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*.bak

# ============================================
# Build outputs & test artifacts (not source of truth)
# ============================================
# Signed/unsigned APK archives kept locally for device testing
/releases/
# Generated test run reports (regenerated on every run).
# Evidence that matters is kept in releases/v<version>-<slug>/ next to the APK
# it describes; a working-directory run is scratch, not history.
05_tests/reports/TEST_REPORT_*.md
05_tests/reports/TEST_REPORT.html
05_tests/reports/RUN_*/

# Python bytecode from the test report tooling
__pycache__/
*.pyc
