{
  "name": "bmw-driving-coach-e2e",
  "version": "1.0.0",
  "description": "Appium E2E tests for BMW Driving Coach Android app (E2E-07)",
  "private": true,
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:permissions": "wdio run wdio.conf.ts --spec test/specs/permissions.spec.ts",
    "test:track": "wdio run wdio.conf.ts --spec test/specs/track-setup.spec.ts",
    "test:recording": "wdio run wdio.conf.ts --spec test/specs/session-recording.spec.ts",
    "test:upload": "wdio run wdio.conf.ts --spec test/specs/session-upload.spec.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
