{
  "name": "driving-coach-backend",
  "version": "1.0.0",
  "description": "Backend API for Driving Coach - telemetry processing and AI coaching",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "jest --coverage",
    "test:unit": "jest --coverage --testPathIgnorePatterns=integration",
    "test:integration": "DATABASE_URL_TEST=${DATABASE_URL_TEST:-postgresql://localhost:5432/driving_coach_test} jest tests/integration --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "db:migrate": "psql $DATABASE_URL -f src/db/schema.sql"
  },
  "keywords": [
    
    "driving",
    "coach",
    "telemetry",
    "lap-times"
  ],
  "author": "Driving Coach Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
