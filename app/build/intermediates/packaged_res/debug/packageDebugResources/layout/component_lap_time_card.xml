<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lapTimeCard"
    style="@style/Widget.BMW.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_sm"
    android:minHeight="@dimen/lap_card_min_height">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <!-- Lap Number Label -->
        <TextView
            android:id="@+id/lapNumberLabel"
            style="@style/TextAppearance.BMW.LapNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="LAP 3" />

        <!-- Best Lap Indicator (Gold Badge) -->
        <TextView
            android:id="@+id/bestLapBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_badge_gold"
            android:paddingHorizontal="@dimen/delta_badge_padding_horizontal"
            android:paddingVertical="@dimen/delta_badge_padding_vertical"
            android:text="BEST"
            android:textColor="@color/dark_background"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/lapNumberLabel"
            app:layout_constraintStart_toEndOf="@id/lapNumberLabel"
            app:layout_constraintTop_toTopOf="@id/lapNumberLabel"
            tools:visibility="visible" />

        <!-- Lap Time (Large Display) -->
        <TextView
            android:id="@+id/lapTimeText"
            style="@style/TextAppearance.BMW.LapTime.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lapNumberLabel"
            tools:text="1:42.387" />

        <!-- Delta Badge -->
        <TextView
            android:id="@+id/deltaText"
            style="@style/TextAppearance.BMW.Delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_delta_badge"
            android:paddingHorizontal="@dimen/delta_badge_padding_horizontal"
            android:paddingVertical="@dimen/delta_badge_padding_vertical"
            app:layout_constraintBottom_toBottomOf="@id/lapTimeText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lapTimeText"
            tools:text="+0.842" />

        <!-- Sector Times (Optional, horizontal layout) -->
        <LinearLayout
            android:id="@+id/sectorTimesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lapTimeText"
            tools:visibility="visible">

            <TextView
                android:id="@+id/sector1Time"
                style="@style/TextAppearance.BMW.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                tools:text="S1: 32.4" />

            <TextView
                android:id="@+id/sector2Time"
                style="@style/TextAppearance.BMW.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                tools:text="S2: 41.2" />

            <TextView
                android:id="@+id/sector3Time"
                style="@style/TextAppearance.BMW.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                tools:text="S3: 28.8" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>