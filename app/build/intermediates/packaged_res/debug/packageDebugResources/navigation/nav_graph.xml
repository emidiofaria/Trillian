<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Onboarding Flow -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.bmw.drivingcoach.ui.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">

        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Auth Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.bmw.drivingcoach.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.bmw.drivingcoach.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Flow -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.bmw.drivingcoach.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_recording"
            app:destination="@id/recordingFragment">
            <argument
                android:name="sessionId"
                app:argType="long" />
        </action>

        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_home_to_session_result"
            app:destination="@id/sessionResultFragment">
            <argument
                android:name="sessionId"
                app:argType="long" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/recordingFragment"
        android:name="com.bmw.drivingcoach.ui.recording.RecordingFragment"
        android:label="Recording"
        tools:layout="@layout/fragment_recording">

        <argument
            android:name="sessionId"
            app:argType="long" />

        <action
            android:id="@+id/action_recording_to_session_result"
            app:destination="@id/sessionResultFragment"
            app:popUpTo="@id/homeFragment">
            <argument
                android:name="sessionId"
                app:argType="long" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/sessionResultFragment"
        android:name="com.bmw.drivingcoach.ui.session.SessionResultFragment"
        android:label="Session Result"
        tools:layout="@layout/fragment_session_result">

        <argument
            android:name="sessionId"
            app:argType="long" />

        <action
            android:id="@+id/action_session_result_to_lap_detail"
            app:destination="@id/lapDetailFragment">
            <argument
                android:name="lapId"
                app:argType="long" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/lapDetailFragment"
        android:name="com.bmw.drivingcoach.ui.session.LapDetailFragment"
        android:label="Lap Detail"
        tools:layout="@layout/fragment_lap_detail">

        <argument
            android:name="lapId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.bmw.drivingcoach.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
