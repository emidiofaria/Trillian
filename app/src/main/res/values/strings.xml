    <!-- Onboarding permission disclosure.
         These are the prominent disclosure shown before the runtime permission
         prompt, so they must describe what actually happens. Play reviews this
         text against the Data Safety declaration: the app records location to
         app-private storage and never transmits it. -->
    <string name="onboarding_title">PERMISSIONS REQUIRED</string>
    <string name="onboarding_location_title">Location</string>
    <string name="onboarding_location_body">Trillian records your GPS position while you drive, so it can measure lap times, speed and track shape. Location is saved only on this phone and is never uploaded or shared.</string>
    <string name="onboarding_storage_title">On-device storage</string>
    <string name="onboarding_storage_body">Every session is written to this phone\'s private storage. Nothing leaves the device unless you export or share it yourself.</string>
    <string name="onboarding_notification_title">Notifications</string>
    <string name="onboarding_notification_body">Shows the recording notification so you can see a session is running. Optional — recording works without it.</string>
    <string name="onboarding_denied_label">Some permissions were denied:</string>
    <string name="onboarding_grant_button">GRANT PERMISSIONS</string>
    <string name="onboarding_permission_location">Location</string>
    <!-- Coaching: sectors -->
    <string name="coach_sector_caveat">Sectors are equal thirds of the distance you drove on each lap, measured by this app — not the circuit\'s official timing sectors. A lap driven on a different line moves the boundaries very slightly.</string>

    <!-- Coaching: sector map -->
    <string name="coach_map_sector_label">S%1$d</string>
    <string name="coach_map_content_description">Circuit map with the three sectors in three colours and the start/finish marked. %1$s</string>
    <string name="coach_map_desc_surveyed">Drawn from the surveyed circuit.</string>
    <string name="coach_map_desc_derived">Drawn from the shape of your own laps.</string>
    <string name="coach_map_desc_single_lap">Drawn from a single lap, so it carries that lap\'s GPS error.</string>
    <string name="coach_map_empty">No map — not enough laps recorded</string>
    <string name="coach_map_note_derived">This shape is drawn from your own laps, so it follows the line you drove rather than the exact edges of the circuit.</string>
    <string name="coach_map_note_single_lap">Drawn from a single lap. With three or more laps the shape settles down and stops following one lap\'s GPS wobble.</string>

    <!-- Coaching: driving fundamentals (CF-01..CF-08) -->
    <string name="coach_fundamentals_title">Driving Fundamentals</string>
    <string name="coach_fundamental_good_cd">You already do this well</string>

    <string name="coach_tip_final_corner_title">Master the final corner</string>
    <string name="coach_tip_final_corner_body">Exit speed is king. The last corner before the main straight decides your speed all the way down it. Brake in a straight line, aim for a smooth, late apex and get back on the throttle early to carry maximum momentum onto the straight.</string>
    <string name="coach_tip_final_corner_good">✓ You cross the line at much the same speed lap after lap — you\'re getting the last corner right.</string>
    <string name="coach_tip_final_corner_needs_work">Your speed over the line drops well below your best on most laps. The exit of the last corner is costing you time down the whole straight.</string>

    <string name="coach_tip_braking_title">Use fixed braking reference points</string>
    <string name="coach_tip_braking_body">Don\'t guess when to brake. For each major corner pick a fixed landmark — a marker board, a kerb, a cone, a tree — and start braking at exactly that point every lap. Only move it closer once you hit it consistently.</string>
    <string name="coach_tip_braking_good">✓ Your sector times are tight from lap to lap — your references are working.</string>
    <string name="coach_tip_braking_needs_work">Your times in Sector %1$d vary a lot from lap to lap. Pick a fixed braking landmark for each corner there and stick to it.</string>

    <string name="coach_tip_slow_in_title">Slow in, fast out</string>
    <string name="coach_tip_slow_in_body">Do most of your braking in a straight line before the turn, then release the brake progressively as you turn in — don\'t drag it to the apex. Let the car roll its speed through the corner and be back on the throttle as you unwind the steering.</string>

    <string name="coach_tip_steering_title">Smooth steering inputs</string>
    <string name="coach_tip_steering_body">Turn the wheel in one fluid, progressive movement and unwind it the same way. Sharp, jerky inputs upset the car\'s balance and scrub off speed. If you find yourself constantly correcting, slow your hands down and look further ahead.</string>

