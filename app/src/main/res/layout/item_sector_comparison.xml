<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sector Label -->
            <TextView
                android:id="@+id/sectorLabel"
                style="@style/TextAppearance.BMW.Caption"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                tools:text="Sector 1" />

            <!-- Selected Lap Time (monospace) -->
            <TextView
                android:id="@+id/selectedTime"
                style="@style/TextAppearance.BMW.Delta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                tools:text="32.4s" />

            <!-- Delta Badge -->
            <TextView
                android:id="@+id/deltaBadge"
                style="@style/TextAppearance.BMW.Delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_delta_badge_small"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                tools:text="+0.342s"
                tools:textColor="@color/colorDeltaNegative" />
        </LinearLayout>

        <!-- Performance Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/spacing_sm">

            <!-- Track (background) -->
            <View
                android:id="@+id/performanceBarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_performance_bar_track" />

            <!-- Fill (foreground) -->
            <View
                android:id="@+id/performanceBarFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_performance_bar_fill" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
