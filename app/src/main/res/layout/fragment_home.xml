<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.home.HomeFragment">

    <!-- Collapsing brand hero (SRS UI-06) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_expanded_height"
        android:background="@color/colorBackground"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/colorBackground"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/colorBackground"
            app:titleEnabled="false">

            <!-- Expanded hero content: parallaxes away as the user scrolls -->
            <LinearLayout
                android:id="@+id/heroContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_md"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

                <FrameLayout
                    android:layout_width="@dimen/hero_emblem_home"
                    android:layout_height="@dimen/hero_emblem_home"
                    android:background="@drawable/bg_hero_ring">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/hero_emblem_description"
                        android:src="@drawable/ic_helmet_emblem" />
                </FrameLayout>

                <TextView
                    android:id="@+id/heroWordmark"
                    style="@style/TextAppearance.DrivingCoach.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/hero_wordmark" />

                <TextView
                    android:id="@+id/heroKicker"
                    style="@style/TextAppearance.DrivingCoach.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/hero_kicker" />
            </LinearLayout>

            <!-- Pinned bar: stays visible once the hero has collapsed -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/heroToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:contentInsetStart="@dimen/spacing_md"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:id="@+id/collapsedBrand"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/hero_emblem_collapsed"
                        android:layout_height="@dimen/hero_emblem_collapsed"
                        android:contentDescription="@string/hero_emblem_description"
                        android:src="@drawable/ic_helmet_emblem" />

                    <TextView
                        style="@style/TextAppearance.DrivingCoach.Wordmark.Collapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/hero_wordmark" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/profileButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/colorOnSurface" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="96dp">

            <!-- Upload Pending Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/uploadBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Upload pending"
                        android:src="@drawable/ic_cloud_upload"
                        app:tint="@color/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/uploadBannerText"
                        style="@style/TextAppearance.DrivingCoach.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="Session upload pending — connect to Wi-Fi"
                        android:textColor="@color/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/dismissBannerButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss"
                        android:src="@drawable/ic_close"
                        app:tint="@color/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Card: Best Lap -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/uploadBanner"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/TextAppearance.DrivingCoach.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR BEST LAP"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/bestLapTime"
                        style="@style/TextAppearance.DrivingCoach.LapTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textColor="@color/colorOnSurface"
                        tools:text="1:41.547" />

                    <TextView
                        android:id="@+id/bestLapInfo"
                        style="@style/TextAppearance.DrivingCoach.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        tools:text="Nürburgring GP • 15 Mar 2024" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Sessions Header -->
            <TextView
                android:id="@+id/recentSessionsTitle"
                style="@style/TextAppearance.DrivingCoach.LapNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="RECENT SESSIONS"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heroCard" />

            <!-- Session History List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sessionsRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recentSessionsTitle"
                tools:itemCount="3"
                tools:listitem="@layout/item_session_history" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recentSessionsTitle"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.DrivingCoach.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_sessions"
                    android:textColor="@color/colorOnSurfaceVariant" />

                <TextView
                    style="@style/TextAppearance.DrivingCoach.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Tap the button below to start" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Start Session: pinned so it stays reachable at any scroll position (SRS UI-06) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startSessionButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cta_pill_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:text="@string/start_session"
        android:textAllCaps="true"
        android:textColor="@color/colorOnPrimary"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="@dimen/cta_pill_radius"
        app:icon="@drawable/ic_dot"
        app:iconGravity="textStart"
        app:iconSize="12dp"
        app:iconTint="@color/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
