<?xml version="1.0" encoding="utf-8"?>
<!-- Driver level card (SRS PG-15): shared by Home, Profile and Rewards -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:id="@+id/levelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/levelBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/colorOnPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="L3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/levelName"
                    style="@style/TextAppearance.DrivingCoach.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Level 3 · Challenger" />

                <TextView
                    android:id="@+id/levelTier"
                    style="@style/TextAppearance.DrivingCoach.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Mid tier" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/levelKmProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:max="1000"
            app:indicatorColor="@color/colorPrimary"
            app:trackColor="@color/progress_track"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/levelKmLabel"
            style="@style/TextAppearance.DrivingCoach.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            tools:text="74.2 km driven · next level at 100 km" />

        <TextView
            android:id="@+id/nextLevelHeader"
            style="@style/TextAppearance.DrivingCoach.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textColor="@color/colorPrimary"
            tools:text="TO REACH LEVEL 4 · Competitor" />

        <LinearLayout
            android:id="@+id/levelRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
