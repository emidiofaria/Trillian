<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_xs">

    <TextView
        android:id="@+id/cornerName"
        style="@style/TextAppearance.DrivingCoach.Body"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:textColor="@color/colorPrimary"
        tools:text="T3" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cornerApex"
            style="@style/TextAppearance.DrivingCoach.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurface"
            tools:text="58.2 km/h apex" />

        <TextView
            android:id="@+id/cornerDetail"
            style="@style/TextAppearance.DrivingCoach.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurfaceVariant"
            tools:text="Right · 84° · t+41.2s" />
    </LinearLayout>
</LinearLayout>
