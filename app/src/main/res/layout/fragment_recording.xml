<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.recording.RecordingFragment">

    <!-- App Logo -->
    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/spacing_xl"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Elapsed Time Label -->
    <TextView
        android:id="@+id/elapsedTimeLabel"
        style="@style/TextAppearance.DrivingCoach.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="SESSION TIME"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appLogo" />

    <!-- Large Elapsed Time Display (MM:SS.mmm) -->
    <TextView
        android:id="@+id/elapsedTime"
        style="@style/TextAppearance.DrivingCoach.LapTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/elapsedTimeLabel"
        tools:text="02:34.567" />

    <!-- GPS Status Row -->
    <LinearLayout
        android:id="@+id/gpsStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/elapsedTime">

        <View
            android:id="@+id/gpsIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_gps_indicator" />

        <TextView
            android:id="@+id/gpsStatusText"
            style="@style/TextAppearance.DrivingCoach.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            tools:text="GPS LOCKED" />
    </LinearLayout>

    <!-- Lap Counter (optional, for future use) -->
    <TextView
        android:id="@+id/lapCounter"
        style="@style/TextAppearance.DrivingCoach.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gpsStatusContainer"
        tools:text="Lap 3"
        tools:visibility="visible" />

    <!-- Stop Recording Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopRecordingButton"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:backgroundTint="#CF3A3A"
        android:text="TAP TO STOP RECORDING"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Recording Indicator -->
    <LinearLayout
        android:id="@+id/recordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/stopRecordingButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/recordingDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/recordingStatusText"
            style="@style/TextAppearance.DrivingCoach.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="RECORDING"
            android:textColor="@color/colorSuccess" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
